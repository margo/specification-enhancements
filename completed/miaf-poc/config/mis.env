MIS_ISSUER_BACKEND=intermediate
MIS_TRUST_DOMAIN=margo.example.com
MIS_BIND_ADDRESS=0.0.0.0:8443
MIS_ADVERTISE_URL=https://localhost:8443
MIS_TLS_CERT_FILE=/etc/mis/tls/server.crt
MIS_TLS_KEY_FILE=/etc/mis/tls/server.key
MIS_CA_INTERMEDIATE_CERT_FILE=/etc/mis/ca/mis-intermediate.crt
MIS_CA_INTERMEDIATE_KEY_FILE=/etc/mis/ca/mis-intermediate.key
MIS_CA_TRUST_ANCHOR_FILE=/etc/mis/ca/root.crt
MIS_FACTORY_CA_FILE=/etc/mis/factory/root.crt
MIS_DB_FILE=/var/lib/mis/mis.sqlite3
MIS_ADMIN_BIND_ADDRESS=127.0.0.1:8444
MIS_ADMIN_URL=http://127.0.0.1:8444
MIS_SVID_TTL=24h
MIS_ALLOW_KEY_ROTATION=true
MIS_ALLOW_NEW_ENROLLMENT=true
MIS_BOOTSTRAP_JWT_CLOCK_SKEW=30s
MIS_ENROLLMENT_TOKEN_RETRY_WINDOW=5m
MIS_ENROLLMENT_TOKEN_DEFAULT_TTL=1h
MIS_RENEWAL_RATE_LIMIT=50
MIS_RENEWAL_RATE_WINDOW=24h
MIS_REVOCATION_PRUNE_INTERVAL=1h
MIS_JWTSVID_KEY_FILE=/etc/mis/jwtsvid/jwtsvid.key
MIS_JWTSVID_DEFAULT_TTL=5m
MIS_JWTSVID_MAX_TTL=1h
MIS_JWTSVID_CLOCK_SKEW=30s
